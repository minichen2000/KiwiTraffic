# Line endings: LF in the repository *and* in the working tree, matching
# .editorconfig (end_of_line = lf). Without this, core.autocrlf on Windows
# rewrites every text file on checkout and produces constant churn.
* text=auto eol=lf

# Explicitly binary - never touch these.
*.exe binary
*.dll binary
*.pdb binary
*.ico binary
*.png binary
