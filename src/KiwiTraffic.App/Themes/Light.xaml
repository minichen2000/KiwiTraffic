<!--
    Light palette. Every key here must also exist in Dark.xaml - the two files
    are swapped wholesale, so a missing key shows up as an unset resource.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E4E4E8" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#F7F7F9" />
    <SolidColorBrush x:Key="TrackBrush" Color="#EFEFF2" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D8D8DE" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F1F1F4" />

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F1F23" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5A5A60" />
    <SolidColorBrush x:Key="FaintTextBrush" Color="#9A9AA0" />

    <!-- Attention -->
    <SolidColorBrush x:Key="NoticeBackgroundBrush" Color="#FFF6DF" />
    <SolidColorBrush x:Key="NoticeBorderBrush" Color="#EFD9A6" />
    <SolidColorBrush x:Key="NoticeTextBrush" Color="#6B5410" />

    <!-- Gauge accents. Colour is decoration only: the number and the wording
         always carry the same information. -->
    <SolidColorBrush x:Key="AccentNormalBrush" Color="#2D7FF9" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="#E09A2B" />
    <SolidColorBrush x:Key="AccentCriticalBrush" Color="#E0454A" />

    <!-- Text sitting on an accent-filled surface. -->
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="#FFFFFF" />

    <!-- The drop shadow reads as a soft grey on a light desktop. -->
    <DropShadowEffect x:Key="SurfaceShadow" BlurRadius="16" ShadowDepth="2" Direction="270"
                      Opacity="0.16" Color="#000000" />

</ResourceDictionary>
