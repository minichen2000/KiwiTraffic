<Window x:Class="KiwiTraffic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KiwiTraffic.App.Converters"
        Title="KiwiTraffic"
        Width="320"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Show" />
    </Window.Resources>

    <StackPanel Margin="16">

        <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Text="{Binding PercentText}" FontSize="42" Margin="0,4,0,0" />

        <!-- Mode=OneWay is required: ProgressBar.Value binds TwoWay by default,
             which fails at runtime against a read-only view model property. -->
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                     Height="10" Margin="0,8,0,0" />

        <TextBlock Text="{Binding UsedQuotaText}" Margin="0,10,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding RemainingText}" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ResetText}" Margin="0,4,0,0" TextWrapping="Wrap" />

        <!-- A failure never replaces the numbers above; it is stated next to them. -->
        <Border Background="#FFF4CE" BorderBrush="#E0C97F" BorderThickness="1" CornerRadius="3"
                Padding="8,4" Margin="0,10,0,0"
                Visibility="{Binding HasStatusMessage, Converter={StaticResource Show}}">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#5A4A00" />
        </Border>

        <Separator Margin="0,12,0,8" />

        <Grid>
            <TextBlock Text="{Binding UpdatedText}" Opacity="0.7" FontSize="11"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="刷新" Padding="12,3" Margin="0,0,8,0"
                        IsEnabled="{Binding IsNotBusy}" Click="OnRefresh" />
                <Button Content="设置…" Padding="12,3" Click="OnOpenSettings" />
            </StackPanel>
        </Grid>

    </StackPanel>
</Window>
