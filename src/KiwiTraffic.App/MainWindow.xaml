<Window x:Class="KiwiTraffic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KiwiTraffic（开发预览）"
        Width="320"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">

        <!-- The preview must never be mistaken for real data. -->
        <Border Background="#FFF4CE" BorderBrush="#E0C97F" BorderThickness="1"
                CornerRadius="3" Padding="8,4" Margin="0,0,0,12">
            <TextBlock Text="模拟数据 · SIMULATED — 尚未连接真实 API"
                       FontWeight="SemiBold" Foreground="#5A4A00" TextWrapping="Wrap" />
        </Border>

        <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="14"
                   TextTrimming="CharacterEllipsis" />

        <TextBlock Text="{Binding PercentText}" FontSize="42" Margin="0,4,0,0" />

        <!-- Mode=OneWay is required: ProgressBar.Value binds TwoWay by default,
             which fails at runtime against a read-only view model property. -->
        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                     Height="10" Margin="0,8,0,0" />

        <TextBlock Text="{Binding UsedQuotaText}" Margin="0,10,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding RemainingText}" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ResetText}" Margin="0,4,0,0" TextWrapping="Wrap" />

        <Separator Margin="0,12,0,8" />

        <TextBlock Text="{Binding UpdatedText}" Opacity="0.7" FontSize="11" TextWrapping="Wrap" />

    </StackPanel>
</Window>
