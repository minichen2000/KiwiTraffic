<Window x:Class="KiwiTraffic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KiwiTraffic.App.Converters"
        xmlns:controls="clr-namespace:KiwiTraffic.App.Controls"
        Title="KiwiTraffic"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Show" />
        <conv:BoolToVisibilityConverter x:Key="Hide" Invert="True" />
        <conv:UsageLevelToBrushConverter x:Key="LevelBrush" />

        <SolidColorBrush x:Key="TrackBrush" Color="#EFEFF2" />
        <SolidColorBrush x:Key="PrimaryText" Color="#1F1F23" />
        <SolidColorBrush x:Key="SecondaryText" Color="#5A5A60" />
        <SolidColorBrush x:Key="FaintText" Color="#9A9AA0" />

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F1F4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the drop shadow, which does not affect layout. -->
    <Border Margin="10" CornerRadius="12" Background="#FFFFFF"
            BorderBrush="#E4E4E8" BorderThickness="1"
            MouseLeftButtonDown="OnCardMouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270"
                              Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Alias}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryText}" TextTrimming="CharacterEllipsis" />

            <!-- Ring indicator -->
            <Grid Grid.Row="1" Height="138" Margin="0,6,0,0"
                  Visibility="{Binding IsRingStyle, Converter={StaticResource Show}}">
                <controls:RingProgress Width="138" Height="138" RingThickness="10"
                                       Value="{Binding ProgressValue, Mode=OneWay}"
                                       TrackBrush="{StaticResource TrackBrush}"
                                       ProgressBrush="{Binding Level, Converter={StaticResource LevelBrush}}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PercentText}" FontSize="27" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}" HorizontalAlignment="Center" />
                    <TextBlock Text="本周期已用" FontSize="10.5" Margin="0,1,0,0"
                               Foreground="{StaticResource FaintText}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Bar indicator -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0"
                        Visibility="{Binding IsBarStyle, Converter={StaticResource Show}}">
                <TextBlock Text="{Binding PercentText}" FontSize="40" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryText}" />
                <controls:BarProgress Margin="0,8,0,0" BarHeight="10"
                                      Value="{Binding ProgressValue, Mode=OneWay}"
                                      TrackBrush="{StaticResource TrackBrush}"
                                      ProgressBrush="{Binding Level, Converter={StaticResource LevelBrush}}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{Binding UsedQuotaText}" Margin="0,14,0,0" FontSize="11.5"
                       Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Text="{Binding RemainingText}" Margin="0,3,0,0" FontSize="11.5"
                       Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="5" Text="{Binding ResetText}" Margin="0,3,0,0" FontSize="11.5"
                       Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />

            <!-- A failure never replaces the numbers above; it is stated next to them. -->
            <Border Grid.Row="6" Background="#FFF6DF" BorderBrush="#EFD9A6" BorderThickness="1"
                    CornerRadius="6" Padding="8,5" Margin="0,10,0,0"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource Show}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap"
                           Foreground="#6B5410" />
            </Border>

            <Grid Grid.Row="7" Margin="0,12,0,0">
                <TextBlock Text="{Binding UpdatedText}" FontSize="10.5" VerticalAlignment="Center"
                           Foreground="{StaticResource FaintText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="刷新" Style="{StaticResource FlatButton}"
                            IsEnabled="{Binding IsNotBusy}" Click="OnRefresh" />
                    <Button Content="设置" Style="{StaticResource FlatButton}" Click="OnOpenSettings" />
                    <Button Content="✕" Style="{StaticResource FlatButton}" Click="OnHide"
                            ToolTip="隐藏到托盘（程序继续运行）" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
