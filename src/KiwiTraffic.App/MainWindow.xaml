<Window x:Class="KiwiTraffic.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:KiwiTraffic.App.Converters"
        xmlns:controls="clr-namespace:KiwiTraffic.App.Controls"
        Title="KiwiTraffic"
        Icon="/Assets/app.ico"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="Show" />
        <conv:BoolToVisibilityConverter x:Key="Hide" Invert="True" />
    </Window.Resources>

    <!-- The margin leaves room for the drop shadow, which does not affect layout. -->
    <Border Margin="10" CornerRadius="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1"
            Effect="{DynamicResource SurfaceShadow}"
            MouseLeftButtonDown="OnCardMouseDown">

        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- The tooltip is only shown when the name really is cut off; see
                 OnAliasToolTipOpening. -->
            <TextBlock Grid.Row="0" Text="{Binding Alias}" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Alias}" ToolTipOpening="OnAliasToolTipOpening" />

            <!-- Ring indicator -->
            <Grid Grid.Row="1" Height="138" Margin="0,6,0,0"
                  Visibility="{Binding IsRingStyle, Converter={StaticResource Show}}">
                <controls:RingProgress Width="138" Height="138" RingThickness="10"
                                       Value="{Binding ProgressValue, Mode=OneWay}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PercentText}" FontSize="27" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="本周期已用" FontSize="10.5" Margin="0,1,0,0"
                               Foreground="{DynamicResource FaintTextBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Bar indicator -->
            <StackPanel Grid.Row="2" Margin="0,8,0,0"
                        Visibility="{Binding IsBarStyle, Converter={StaticResource Show}}">
                <TextBlock Text="{Binding PercentText}" FontSize="40" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <controls:BarProgress Margin="0,8,0,0" BarHeight="10"
                                      Value="{Binding ProgressValue, Mode=OneWay}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{Binding UsedQuotaText}" Margin="0,14,0,0" FontSize="11.5"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Text="{Binding RemainingText}" Margin="0,3,0,0" FontSize="11.5"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="5" Text="{Binding ResetText}" Margin="0,3,0,0" FontSize="11.5"
                       Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />

            <!-- A failure never replaces the numbers above; it is stated next to them. -->
            <Border Grid.Row="6" CornerRadius="6" Padding="8,5" Margin="0,10,0,0"
                    Background="{DynamicResource NoticeBackgroundBrush}"
                    BorderBrush="{DynamicResource NoticeBorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasStatusMessage, Converter={StaticResource Show}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource NoticeTextBrush}" />
            </Border>

            <Grid Grid.Row="7" Margin="0,12,0,0">
                <TextBlock Text="{Binding UpdatedText}" FontSize="10.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap"
                           ToolTip="{Binding UpdatedTooltip}"
                           ToolTipService.ShowDuration="20000" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="刷新" Style="{StaticResource FlatButton}"
                            IsEnabled="{Binding IsNotBusy}" Click="OnRefresh" />
                    <Button Content="设置" Style="{StaticResource FlatButton}" Click="OnOpenSettings" />
                    <Button Content="✕" Style="{StaticResource FlatButton}" Click="OnHide"
                            ToolTip="隐藏到托盘（程序继续运行）" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
